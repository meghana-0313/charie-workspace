{
  "name": "circle-back",
  "version": "0.1.0",
  "private": true,
  "description": "GhostQA — autonomous product-quality engineer: ticket to verified fix in a closed loop.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "demo:target": "npm run dev --workspace apps/demo-target",
    "agent:run": "npm run run --workspace services/agent-engine",
    "agent:build": "npm run build --workspace services/agent-engine",
    "portal:dev": "npm run dev --workspace apps/portal",
    "portal:build": "npm run build --workspace apps/portal"
  },
  "engines": {
    "node": ">=20"
  }
}
