{
  "name": "charie-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Charie - autonomous engineering intelligence: testing, security, production.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "demo:target": "npm run dev --workspace apps/demo-target",
    "agent:run": "npm run run --workspace services/agent-engine",
    "agent:build": "npm run build --workspace services/agent-engine",
    "portal:dev": "npm run dev --workspace apps/portal",
    "portal:build": "npm run build --workspace apps/portal",
    "test": "npm run test --workspace services/agent-engine && npm run smoke --workspace services/mcp-server"
  },
  "engines": {
    "node": ">=20"
  }
}
