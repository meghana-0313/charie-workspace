# GhostQA portal (Next.js standalone) → Cloud Run.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/portal/package.json ./apps/portal/
COPY apps/demo-target/package.json ./apps/demo-target/
COPY services/agent-engine/package.json ./services/agent-engine/
COPY services/mcp-server/package.json ./services/mcp-server/
RUN npm ci --workspace @circle-back/portal

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/portal ./apps/portal
RUN npm run build --workspace @circle-back/portal

FROM node:22-bookworm-slim AS run
ENV NODE_ENV=production
ENV PORT=3102
ENV HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build /app/apps/portal/.next/standalone ./
COPY --from=build /app/apps/portal/.next/static ./apps/portal/.next/static
EXPOSE 3102
CMD ["node", "apps/portal/server.js"]
