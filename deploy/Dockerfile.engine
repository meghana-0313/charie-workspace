# GhostQA engine (Playwright agent + HTTP service) → Cloud Run.
FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps/portal/package.json ./apps/portal/
COPY apps/demo-target/package.json ./apps/demo-target/
COPY services/agent-engine/package.json ./services/agent-engine/
COPY services/mcp-server/package.json ./services/mcp-server/
RUN npm ci --workspace @circle-back/agent-engine
COPY services/agent-engine ./services/agent-engine
RUN npm run build --workspace @circle-back/agent-engine

FROM node:22-bookworm-slim AS run
ENV NODE_ENV=production
ENV PORT=3103
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/portal/package.json ./apps/portal/
COPY apps/demo-target/package.json ./apps/demo-target/
COPY services/agent-engine/package.json ./services/agent-engine/
COPY services/mcp-server/package.json ./services/mcp-server/
RUN npm ci --workspace @circle-back/agent-engine --omit=dev
RUN npm exec --workspace @circle-back/agent-engine -- playwright install --with-deps chromium
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/services/agent-engine/dist ./services/agent-engine/dist
WORKDIR /app/services/agent-engine
EXPOSE 3103
CMD ["node", "dist/serve.js"]
